########################################
# Just Dental Clinic — environment example
# Copy to .env and fill in real values. NEVER commit a real .env or secrets.
########################################

APP_NAME="Just Dental Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Security: set true in production (HTTPS) so session cookies are Secure-only.
SESSION_SECURE_COOKIE=false
# Set false only if the Content-Security-Policy blocks a needed resource.
SECURITY_CSP_ENABLED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database (MySQL) ----
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=justdental
DB_USERNAME=justdental
DB_PASSWORD=secret

# ---- MongoDB (for messages) ----
MONGO_DSN=mongodb://mongo:27017
MONGO_DATABASE=justdental_messages

# ---- Redis (sessions/cache) ----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Payment Gateway (PayMongo) ----
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=

# ---- reCAPTCHA ----
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

# ---- Firebase (optional for notifications) ----
FIREBASE_CREDENTIALS=
