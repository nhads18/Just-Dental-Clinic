########################################
# Just Dental Clinic — environment example
# Copy to .env and fill in real values. NEVER commit a real .env or secrets.
########################################

APP_NAME="Just Dental Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database (MySQL) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=justdental
DB_USERNAME=justdental
DB_PASSWORD=

# ---- MongoDB (chat messages) ----
MONGO_DSN=mongodb://127.0.0.1:27017
MONGO_DATABASE=justdental_messages

# ---- Session / Cache / Queue ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Redis (optional) ----
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Broadcasting (Pusher / real-time) ----
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---- Mail ----
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@justdental.example"
MAIL_FROM_NAME="${APP_NAME}"

# ---- OAuth (Google) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT="${APP_URL}/auth/google/callback"

# ---- OAuth (Facebook — optional) ----
FB_CLIENT_ID=
FB_CLIENT_SECRET=
FB_CALLBACK_REDIRECTS="${APP_URL}/auth/facebook/callback"

# ---- PayMongo (use TEST keys in non-prod; never commit LIVE keys) ----
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=

# ---- Firebase (optional; path to service-account JSON, kept OUTSIDE the repo) ----
FIREBASE_CREDENTIALS=

# ---- Groq AI chatbot (optional) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- reCAPTCHA / captcha ----
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

########################################
# Clinic identity (see config/clinic.php). All optional — sensible
# Just Dental Clinic defaults apply when unset. Fill with real details.
########################################
CLINIC_NAME="Just Dental Clinic"
CLINIC_SHORT_NAME="Just Dental"
CLINIC_LEGAL_NAME="Just Dental Clinic"
CLINIC_TAGLINE="Modern, caring dentistry for the whole family."
CLINIC_LOGO="img/logo.svg"
CLINIC_FAVICON="favicon.ico"
CLINIC_ASSISTANT_NAME="Aether AI"

CLINIC_EMAIL=
CLINIC_PHONE=
CLINIC_ADDRESS_LINE1=
CLINIC_ADDRESS_LINE2=
CLINIC_ADDRESS_CITY=
CLINIC_ADDRESS_PROVINCE=
CLINIC_ADDRESS_COUNTRY="Philippines"
CLINIC_ADDRESS_POSTAL=
CLINIC_MAP_EMBED_URL=

CLINIC_WEBSITE=
CLINIC_FACEBOOK=
CLINIC_INSTAGRAM=

CLINIC_TIMEZONE="Asia/Manila"
CLINIC_CURRENCY_CODE="PHP"
CLINIC_CURRENCY_SYMBOL="₱"

# Operating hours (human-readable per day)
CLINIC_HOURS_MON="9:00 AM – 6:00 PM"
CLINIC_HOURS_TUE="9:00 AM – 6:00 PM"
CLINIC_HOURS_WED="9:00 AM – 6:00 PM"
CLINIC_HOURS_THU="9:00 AM – 6:00 PM"
CLINIC_HOURS_FRI="9:00 AM – 6:00 PM"
CLINIC_HOURS_SAT="9:00 AM – 3:00 PM"
CLINIC_HOURS_SUN="Closed"
